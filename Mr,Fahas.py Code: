                else:
                    print(f"\n❌ أمر غير معروف: '{cmd}'")
                    print("💡 اكتب 'hlp' للقائمة")
                    
            except KeyboardInterrupt:
                print("\n\n👋 وداعاً!")
                break
            except Exception as e:
                print(f"\n❌ خطأ: {str(e)[:50]}")

