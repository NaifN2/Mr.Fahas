    def parse_url(self, url):
        """تحليل الرابط"""
        try:
            if not url.startswith(('http://', 'https://')):
                url = 'https://' + url
            parsed = urlparse(url)
            return {'scheme': parsed.scheme, 'domain': parsed.netloc, 'path': parsed.path, 'valid': True}
        except Exception as e:
            return {'valid': False, 'error': str(e)}
    
    def chk_security(self, url):
        """chk = فحص أمان الرابط"""
        print("\n" + "─"*50)
        print("🔒 فحص الأمان...")
        print("─"*50)
        
        parsed = self.parse_url(url)
        if not parsed['valid']:
            print(f"❌ رابط غير صالح: {parsed.get('error')}")
            return
        
        results = []
        
        # HTTPS
        if parsed['scheme'] == 'https':
            results.append(("بروتوكول", "✅", "HTTPS نشط"))
        else:
            results.append(("بروتوكول", "⚠️", "HTTP فقط"))
        
        # SSL
        try:
            hostname = parsed['domain']
            context = ssl.create_default_context()
            with socket.create_connection((hostname, 443), timeout=5) as sock:
                with context.wrap_socket(sock, server_hostname=hostname) as ssock:
                    cert = ssock.getpeercert()
                    issuer = cert.get('issuer', {}).get('organizationName', 'Unknown')
                    results.append(("شهادة SSL", "✅", f"{issuer[:25]}"))
        except Exception as e:
            results.append(("شهادة SSL", "⚠️", f"لا يمكن التحقق"))
        
        # DNS
        try:
            ip = socket.gethostbyname(parsed['domain'])
            results.append(("DNS", "✅", f"IP: {ip}"))
        except:
            results.append(("DNS", "❌", "فشل الحل"))
        
        print(f"\nالرابط: {url}\n")
        for feat, status, detail in results:
            print(f"   {status} {feat}: {detail}")
        
        score = sum(1 for r in results if r[1] == '✅')
        pct = (score / len(results) * 100) if results else 0
        print(f"\n📊 التقييم: {pct:.0f}%")
        print("✅ آمن" if pct >= 80 else "⚠️ حذر" if pct >= 50 else "❌ غير آمن")
    
