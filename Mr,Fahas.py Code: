    def chk_status(self, url):
        """stg = فحص حالة الموقع"""
        print("\n" + "─"*50)
        print("🟢 فحص الحالة...")
        print("─"*50)
        
        parsed = self.parse_url(url)
        if not parsed['valid']:
            print(f"❌ رابط غير صالح")
            return
        
        try:
            print(f"\n   اتصال بـ {parsed['domain']}...")
            start = datetime.now()
            
            req = urllib.request.Request(url, method='HEAD', headers={
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'
            })
            response = urllib.request.urlopen(req, timeout=10)
            code = response.getcode()
            
            end = datetime.now()
            elapsed = (end - start).total_seconds()
            
            print(f"\n📊 النتائج:")
            print(f"   🏠 {url}")
            print(f"   🟢 {code}")
            print(f"   ⏱️ {elapsed:.2f} ثانية")
            
            if code == 200:
                print(f"\n✅ الموقع شغال")
            elif code in [301, 302]:
                print(f"\n⚠️ إعادة توجيه")
            elif code == 403:
                print(f"\n🚫 ممنوع الوصول")
            elif code == 404:
                print(f"\n❌ الصفحة مفقودة")
            elif code == 500:
                print(f"\n💥 خطأ الخادم")
                
        except urllib.error.HTTPError as e:
            print(f"\n❌ HTTP Error: {e.code}")
        except urllib.error.URLError:
            print(f"\n❌ لا يمكن الاتصال")
        except socket.timeout:
            print(f"\n⏰ مهلة connection")
        except Exception as e:
            print(f"\n❌ خطأ: {str(e)[:40]}")
    
